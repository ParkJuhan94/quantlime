{
  "uid": "quantlime-business",
  "title": "QuantLime - 비즈니스 지표 (Toss / 스윕 / 퀀트엔진)",
  "tags": ["quantlime", "business"],
  "timezone": "Asia/Seoul",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Toss API 호출 결과별 비율(rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(toss_api_calls_total{job=\"backend\"}[5m])) by (endpoint, outcome)",
          "legendFormat": "{{endpoint}} - {{outcome}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Toss 429(Rate Limit) 발생률",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.5 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(toss_api_calls_total{job=\"backend\", outcome=\"rate_limited\"}[5m]))",
          "legendFormat": "429/s"
        }
      ]
    },
    {
      "id": 3,
      "title": "Toss API 평균 응답시간(endpoint별)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(toss_api_duration_seconds_sum{job=\"backend\"}[5m])) by (endpoint) / sum(rate(toss_api_duration_seconds_count{job=\"backend\"}[5m])) by (endpoint)",
          "legendFormat": "{{endpoint}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "전종목 스윕(MarketPriceSweepScheduler) 소요시간",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "rate(market_sweep_duration_seconds_sum{job=\"backend\"}[5m]) / rate(market_sweep_duration_seconds_count{job=\"backend\"}[5m])",
          "legendFormat": "평균 소요시간"
        },
        {
          "expr": "market_sweep_duration_seconds_max{job=\"backend\"}",
          "legendFormat": "최대(max)"
        }
      ]
    },
    {
      "id": 5,
      "title": "스윕 청크 스킵 발생률(429 등)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(market_sweep_chunk_skipped_total{job=\"backend\"}[5m])) by (reason)",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "퀀트 엔진 호출 실패율",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 0.2 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(python_engine_calls_total{job=\"backend\", outcome=\"failure\"}[15m])) / sum(rate(python_engine_calls_total{job=\"backend\"}[15m]))",
          "legendFormat": "failure ratio"
        }
      ]
    },
    {
      "id": 7,
      "title": "스코어 배치 응답 누락 종목 수(rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(score_batch_missing_from_response_total{job=\"backend\"}[15m])",
          "legendFormat": "missing/sec"
        }
      ]
    },
    {
      "id": 8,
      "title": "퀀트 엔진 평균 응답시간",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "rate(python_engine_duration_seconds_sum{job=\"backend\"}[5m]) / rate(python_engine_duration_seconds_count{job=\"backend\"}[5m])",
          "legendFormat": "평균 응답시간"
        }
      ]
    },
    {
      "id": 9,
      "title": "서킷브레이커 상태(toss / quant-engine / upbit / naver-finance)",
      "type": "state-timeline",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "2026-08-17 도입(resilience4j). state=0 CLOSED, 1 OPEN, 2 HALF_OPEN - alerts.yml의 CircuitBreakerOpen 알림과 연동.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "CLOSED", "color": "green" },
                "1": { "text": "OPEN", "color": "red" },
                "2": { "text": "HALF_OPEN", "color": "yellow" }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(resilience4j_circuitbreaker_state{job=\"backend\", state=\"open\"} * 1 + resilience4j_circuitbreaker_state{job=\"backend\", state=\"half_open\"} * 2) by (name)",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "서킷브레이커 실패율(집계, 429 제외)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "expr": "resilience4j_circuitbreaker_failure_rate{job=\"backend\"} / 100",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 11,
      "title": "Kafka 컨슈머 lag (그룹별 합, 브로커 커밋 오프셋 기준)",
      "description": "KafkaConsumerLagMonitor가 30초마다 갱신. 배치 때 오르고 처리되며 0으로 돌아오는 것이 정상이다.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (group) (kafka_consumer_group_lag{job=\"backend\"})",
          "legendFormat": "{{group}}"
        }
      ]
    },
    {
      "id": 12,
      "title": "Kafka 컨슈머 처리 속도 (건/초, 5분 rate)",
      "description": "커밋 오프셋 증가율. 배치 1회 규모 추정 = 이 속도로 약 8,100건을 처리하는 시간.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (group) (rate(kafka_consumer_group_committed_offsets_total{job=\"backend\"}[5m]))",
          "legendFormat": "{{group}}"
        }
      ]
    },
    {
      "id": 13,
      "title": "Kafka 컨슈머 정지 시간 (lag가 있는데 커밋이 안 움직인 시간)",
      "description": "KafkaConsumerStalled 알림 기준은 900초(15분). 정상 배치는 오래 걸려도 0에 머문다.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "expr": "max by (group) (kafka_consumer_group_stalled_seconds{job=\"backend\"})",
          "legendFormat": "{{group}}"
        }
      ]
    },
    {
      "id": 14,
      "title": "Redpanda 메모리 (사용 vs 한도)",
      "description": "호스트 크론이 1분마다 찍는 스냅샷이라 1분 미만의 순간 피크는 못 본다.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "expr": "quantlime_container_memory_usage_bytes{name=~\".*redpanda\"}",
          "legendFormat": "사용"
        },
        {
          "expr": "quantlime_container_memory_limit_bytes{name=~\".*redpanda\"}",
          "legendFormat": "한도"
        }
      ]
    },
    {
      "id": 15,
      "title": "Redpanda 재시작 · 호스트 OOM kill (5분)",
      "description": "0이면 정상. 배치 시간대에 값이 생기면 Redpanda 메모리 한도를 의심한다.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 48 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "expr": "changes(quantlime_container_start_time_seconds{name=~\".*redpanda\"}[5m])",
          "legendFormat": "Redpanda 재시작"
        },
        {
          "expr": "increase(node_vmstat_oom_kill[5m])",
          "legendFormat": "호스트 OOM kill"
        }
      ]
    }
  ]
}

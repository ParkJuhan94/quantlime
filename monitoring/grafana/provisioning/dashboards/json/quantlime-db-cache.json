{
  "uid": "quantlime-db-cache",
  "title": "QuantLime - DB/캐시 포화",
  "tags": ["quantlime", "db", "cache"],
  "timezone": "Asia/Seoul",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "HikariCP 대기/활성/유휴 커넥션 (maximum-pool-size=10)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        { "expr": "hikaricp_connections_pending{job=\"backend\"}", "legendFormat": "pending" },
        { "expr": "hikaricp_connections_active{job=\"backend\"}", "legendFormat": "active" },
        { "expr": "hikaricp_connections_idle{job=\"backend\"}", "legendFormat": "idle" }
      ]
    },
    {
      "id": 2,
      "title": "InnoDB 버퍼풀 히트율 (운영 512MB vs hot dataset ~1.1GB, docker-compose.prod.yml 참고)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.9 },
              { "color": "green", "value": 0.98 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "1 - (rate(mysql_global_status_innodb_buffer_pool_reads[5m]) / rate(mysql_global_status_innodb_buffer_pool_read_requests[5m]))",
          "legendFormat": "히트율"
        }
      ]
    },
    {
      "id": 3,
      "title": "MySQL 슬로우 쿼리 발생률 (long_query_time=1초, 2026-09 활성화)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        { "expr": "rate(mysql_global_status_slow_queries[5m])", "legendFormat": "slow queries/s" }
      ]
    },
    {
      "id": 4,
      "title": "MySQL 초당 처리 행 수 (읽기/삽입/갱신)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        { "expr": "rate(mysql_global_status_innodb_rows_read[1m])", "legendFormat": "rows_read" },
        { "expr": "rate(mysql_global_status_innodb_rows_inserted[1m])", "legendFormat": "rows_inserted" },
        { "expr": "rate(mysql_global_status_innodb_rows_updated[1m])", "legendFormat": "rows_updated" }
      ]
    },
    {
      "id": 5,
      "title": "MySQL 커넥션 사용률 (Threads_connected / max_connections=151)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        { "expr": "mysql_global_status_threads_connected", "legendFormat": "connected" },
        { "expr": "mysql_global_variables_max_connections", "legendFormat": "max(설정값)" }
      ]
    },
    {
      "id": 6,
      "title": "Redis 메모리 사용률 (maxmemory 200mb, volatile-lru)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.8 },
              { "color": "red", "value": 0.95 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "redis_memory_used_bytes / redis_memory_max_bytes", "legendFormat": "사용률" }
      ]
    },
    {
      "id": 7,
      "title": "Redis 키 축출(eviction) - 발생 시 시세/랭킹 캐시 조기 유실 신호",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        { "expr": "increase(redis_evicted_keys_total[5m])", "legendFormat": "evicted (5m)" }
      ]
    },
    {
      "id": 8,
      "title": "Redis 명령 히트/미스 (keyspace_hits vs keyspace_misses)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        { "expr": "rate(redis_keyspace_hits_total[5m])", "legendFormat": "hits/s" },
        { "expr": "rate(redis_keyspace_misses_total[5m])", "legendFormat": "misses/s" }
      ]
    },
    {
      "id": 9,
      "title": "Lettuce(Redis 클라이언트) 커맨드 완료 지연시간 - 단일 공유 커넥션 병목 확인용",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "expr": "rate(lettuce_command_completion_seconds_sum{job=\"backend\"}[5m]) / rate(lettuce_command_completion_seconds_count{job=\"backend\"}[5m])",
          "legendFormat": "{{command}} 평균"
        },
        {
          "expr": "lettuce_command_completion_seconds_max{job=\"backend\"}",
          "legendFormat": "{{command}} 최대"
        }
      ]
    },
    {
      "id": 10,
      "title": "스코어 랭킹 캐시 히트율 (ScoreRankingCacheStore, 2026-09 신설)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(score_ranking_cache_access_total{job=\"backend\", result=\"hit\"}[15m])) / sum(rate(score_ranking_cache_access_total{job=\"backend\"}[15m]))",
          "legendFormat": "히트율"
        }
      ]
    },
    {
      "id": 11,
      "title": "MySQL Uptime (재시작 여부 확인 - 리셋되면 위 rate() 패널이 일시적으로 튐)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        { "expr": "mysql_global_status_uptime", "legendFormat": "uptime" }
      ]
    }
  ]
}

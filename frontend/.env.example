VITE_API_BASE_URL=http://localhost:8080

# OAuth 클라이언트 ID(공개값 - 시크릿은 백엔드 .env에만 존재).
# 리다이렉트 URI는 코드에서 window.location.origin 기준으로 동적 생성해
# 백엔드로 넘기므로 여기엔 없음 - 대신 각 프로바이더 콘솔에 등록된
# Authorized Redirect URI와 정확히 일치해야 하므로 프론트 개발 서버
# 포트(3001)를 임의로 바꾸지 말 것.
VITE_GOOGLE_CLIENT_ID=your_google_client_id
VITE_KAKAO_CLIENT_ID=your_kakao_client_id
VITE_NAVER_CLIENT_ID=your_naver_client_id

# 토스페이먼츠 결제위젯 클라이언트 키(공개값 - 시크릿키는 백엔드 .env에만
# 존재). 사업자등록 전에는 토스페이먼츠 개발자센터에서 발급되는 테스트
# 클라이언트 키만 사용 가능.
VITE_TOSS_PAYMENTS_CLIENT_KEY=your_toss_payments_test_client_key

# 알림(Web Push) - Firebase 콘솔 > 프로젝트 설정 > 일반 > "내 앱"의 웹
# 설정값(공개값, 시크릿 아님). VAPID 키는 같은 콘솔의 Cloud Messaging >
# 웹 구성 > 키 쌍에서 발급. public/firebase-messaging-sw.js에도 같은
# apiKey/projectId/messagingSenderId/appId를 직접 채워 넣어야 한다(서비스
# 워커는 정적 파일이라 이 .env를 못 읽음).
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_VAPID_KEY=your_firebase_vapid_key

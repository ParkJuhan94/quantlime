TOSS_CLIENT_ID=your_client_id
TOSS_CLIENT_SECRET=your_client_secret
TOSS_BASE_URL=https://openapi.tossinvest.com

# 토스페이먼츠(결제/구독) - 위 TOSS_*(토스증권 시세 조회)와는 완전히 다른
# 제품/키. 테스트 키(API 개별 연동 키, test_ck_/test_sk_ - 결제위젯 연동
# 키 아님, 프론트가 requestBillingAuth를 쓰기 때문)도 발급에 사업자등록번호가
# 필요하다(2026-09-25 확인). 비워두면 로컬 자동갱신 결제는 항상 거절돼 재시도
# 카운트만 쌓인다. 라이브 전환 시 이 값들만 교체하면 된다.
TOSS_PAYMENTS_CLIENT_KEY=your_toss_payments_test_client_key
TOSS_PAYMENTS_SECRET_KEY=your_toss_payments_test_secret_key
# 웹훅 서명 검증용 - 비어 있으면 검증을 건너뛴다(로컬 테스트 전용, 운영에선 필수)
TOSS_PAYMENTS_WEBHOOK_SECRET=

# 빌링키(카드 자동결제 권한 토큰) DB 컬럼 암호화 키(base64 32바이트, AES-GCM).
# 비어 있으면 평문 저장(로컬 개발 전용) - 운영 배포 전 반드시 채울 것.
# 생성 예: openssl rand -base64 32
SUBSCRIPTION_BILLING_KEY_ENCRYPTION_KEY=

PYTHON_ENGINE_URL=http://localhost:8000
REALTIME_PRICE_POLL_INTERVAL_MS=3000
MARKET_RANKING_POLL_INTERVAL_MS=5000
DB_USER=root
DB_PASSWORD=quantlime
MYSQL_HOST=localhost
MYSQL_PORT=3308
MYSQL_DATABASE=quantlime
REDIS_HOST=localhost
REDIS_PORT=6381

APP_CORS_ALLOWED_ORIGIN=http://localhost:3001

JWT_SECRET=change_this_to_a_long_random_secret
JWT_ACCESS_TOKEN_VALIDITY=1800000
JWT_REFRESH_TOKEN_VALIDITY=1209600000

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

KAKAO_CLIENT_ID=your_kakao_client_id
KAKAO_CLIENT_SECRET=your_kakao_client_secret

NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# 사이드패널 "의견 보내기"가 전송할 Slack Incoming Webhook URL. 비어 있으면
# 의견 보내기 API가 명시적으로 WEBHOOK_NOT_CONFIGURED 에러를 반환한다.
SLACK_FEEDBACK_WEBHOOK_URL=

# 투자 콘텐츠 요약 피드(유튜브 채널 수집) - Google Cloud Console에서
# YouTube Data API v3를 활성화하고 발급받은 API 키. 커밋 금지.
YOUTUBE_API_KEY=

# 국내 종목마스터(신규상장/상장폐지) 동기화 - opendart.fss.or.kr에서
# 무료로 발급받는 인증키(회원가입 필요). KIND 스크래핑을 대체함(2026-09).
DART_API_KEY=

# 로컬↔운영 자막 동기화(youtube-transcript-api의 운영 IP 차단 우회) -
# SYNC_API_KEY는 운영 .env.prod와 반드시 같은 값이어야 한다(대칭키).
# 비워두면 로컬 자막 저장 시 운영 동기화가 조용히 스킵된다.
SYNC_API_KEY=
SYNC_PROD_API_BASE=https://quantlime.com

# 알림 기능(Web Push) - Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 >
# "새 비공개 키 생성"으로 받은 JSON 파일의 경로. 비워두면 인앱 알림
# 저장은 그대로 동작하고 푸시 발송만 건너뛴다. 파일 자체는 커밋 금지
# (.gitignore 등록 완료). **반드시 절대경로로 지정할 것** - Spring Boot
# Gradle 플러그인의 :api:bootRun은 워킹디렉터리를 backend/가 아니라
# backend/api/로 잡아서, 상대경로(./firebase-service-account.json)를 쓰면
# FileNotFoundException으로 기동이 실패한다(2026-09-24 실제 발견 -
# UPLOAD_DIR/logs.file.name과 같은 부류의 실행위치 의존 버그).
FCM_SERVICE_ACCOUNT_PATH=/absolute/path/to/quantlime/backend/firebase-service-account.json

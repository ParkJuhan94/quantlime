# load-test/config/env.example
#
# 실제 값은 이 파일을 복사해 load-test/config/env로 만들어 채운다
# (load-test/config/env는 .gitignore 대상 - 호스트/토큰이 커밋되지 않게).
#
#   cp load-test/config/env.example load-test/config/env
#   set -a && source load-test/config/env && set +a

# ── 부하 대상 ──────────────────────────────────────────────────────
# 로컬 검증은 반드시 8081(전역 규칙 - 8080은 사용자의 라이브 개발 서버)
BASE_URL=http://localhost:8081
WS_BASE_URL=ws://localhost:8081
TARGET_ENV=local

# EC2로 쏠 때는 아래로 교체하고 TARGET_ENV=prod, I_KNOW_THIS_IS_PROD=yes 필요
# BASE_URL=http://<app-ec2-host>
# WS_BASE_URL=ws://<app-ec2-host>
# TARGET_ENV=prod

# ── 인증 ──────────────────────────────────────────────────────────
# 로컬: seed.sh가 POST /dev/auth/token으로 자동 발급하므로 비워둬도 됨.
# EC2: /dev/auth/token을 쓸 수 없어(prod 프로파일 미로드 + nginx 405) JWT를
#      오프라인 서명해야 한다 - backend/.env의 JWT_SECRET 값을 그대로 채운다.
JWT_SECRET=

# ── 앱 자체 관측 스택 (Prometheus/Grafana - k6 InfluxDB/Grafana와 별개) ──
APP_HOST=localhost
APP_GRAFANA_PORT=3002
# run/annotate.sh가 부하 테스트 구간을 앱 Grafana에 어노테이션으로 남기려면 필요.
# Grafana > 설정 > API keys/Service accounts에서 발급(Editor 이상 권한).
GRAFANA_API_TOKEN=

# ── k6 결과 출력 백엔드 ─────────────────────────────────────────────
# influxdb-v1 | influxdb-v2 | json (폴백, 추가 인프라 불필요)
K6_OUTPUT_MODE=json
INFLUX_HOST=
INFLUX_PORT=8086
# v1: 데이터베이스명. v2: org/bucket/token.
INFLUX_DB=k6
INFLUX_ORG=
INFLUX_BUCKET=
INFLUX_TOKEN=

# k6가 3.5의 프로브 A/B로 실제 버전을 확인한 뒤 위 K6_OUTPUT_MODE를 정할 것 -
# 추측해서 먼저 정하지 않는다.
